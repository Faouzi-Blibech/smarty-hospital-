{
  "id": "wardFollowUpW6xx",
  "name": "W6 · Discharge follow-up",
  "nodes": [
    {
      "id": "e6d0f1a2-0000-4000-8000-000000000601",
      "name": "From router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "e6d0f1a2-0000-4000-8000-000000000602",
      "name": "Prepare follow-up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// event patient.discharged: {patient_id, patient_first_name, patient_email, patient_telegram_chat_id, doctor_id, discharged_at}\nconst FOLLOW_UP_DAYS = 14;\nreturn $input.all()\n  .map(i => i.json.data || {})\n  .filter(d => d.patient_id)\n  .map(d => ({ json: {\n    patient_id: d.patient_id,\n    days: FOLLOW_UP_DAYS,\n    first_name: d.patient_first_name ?? '',\n    chat_id: d.patient_telegram_chat_id ? String(d.patient_telegram_chat_id) : null,\n    email: d.patient_email || null,\n  } }));"
      }
    },
    {
      "id": "e6d0f1a2-0000-4000-8000-000000000603",
      "name": "follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WARD_API_URL }}/integrations/n8n/follow-up",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Secret",
              "value": "={{ $env.N8N_CALLBACK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ patient_id: $json.patient_id, days: $json.days }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 10000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "e6d0f1a2-0000-4000-8000-000000000604",
      "name": "Patient message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "// Only tell the patient about a follow-up that the backend actually created.\n// The HTTP node emits one response per input item, so index i pairs with \"Prepare follow-up\" item i.\nconst prepared = $('Prepare follow-up').all();\nconst out = [];\n$input.all().forEach((item, i) => {\n  const res = item.json;                       // full response: {statusCode, body}\n  if (res.statusCode !== 200 || !res.body?.appointment_id) return;\n  const p = prepared[i].json;\n  const text = `Hi ${p.first_name}, you have been discharged. Your follow-up visit in about ${p.days} days has been requested; the hospital will confirm the date and remind you the day before.\nTake care.`;\n  out.push({ json: { appointment_id: res.body.appointment_id, chat_id: p.chat_id, email: p.email,\n                     subject: 'Your follow-up visit', text } });\n});\nreturn out;"
      }
    },
    {
      "id": "e6d0f1a2-0000-4000-8000-000000000605",
      "name": "Has WhatsApp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -120
      ],
      "parameters": {
        "jsCode": "// Demo routing: patient messages go to every number in WARD_WHATSAPP_PATIENT (comma-separated, country code first).\nconst nums = [...new Set(($env.WARD_WHATSAPP_PATIENT || '').split(',').map(s => s.replace(/\\D/g, '')).filter(Boolean))];\nreturn $input.all().flatMap(i => nums.map(to => ({ json: { ...i.json, to } })));"
      }
    },
    {
      "id": "e6d0f1a2-0000-4000-8000-000000000606",
      "name": "WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WAHA_URL }}/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $env.WAHA_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: 'default', chatId: $json.to + '@c.us', text: $json.text, linkPreview: false }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "e6d0f1a2-0000-4000-8000-000000000607",
      "name": "Has email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        120
      ],
      "parameters": {
        "jsCode": "return $input.all().filter(i => i.json.email);"
      }
    },
    {
      "id": "e6d0f1a2-0000-4000-8000-000000000608",
      "name": "Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1200,
        120
      ],
      "parameters": {
        "fromEmail": "={{ $env.WARD_MAIL_FROM }}",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "onError": "continueRegularOutput",
      "credentials": {
        "smtp": {
          "id": "wardSmtpCred0001",
          "name": "ward-smtp"
        }
      }
    }
  ],
  "connections": {
    "From router": {
      "main": [
        [
          {
            "node": "Prepare follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare follow-up": {
      "main": [
        [
          {
            "node": "follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "follow-up": {
      "main": [
        [
          {
            "node": "Patient message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Patient message": {
      "main": [
        [
          {
            "node": "Has WhatsApp",
            "type": "main",
            "index": 0
          },
          {
            "node": "Has email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has email": {
      "main": [
        [
          {
            "node": "Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has WhatsApp": {
      "main": [
        [
          {
            "node": "WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Tunis"
  },
  "pinData": {},
  "tags": []
}
